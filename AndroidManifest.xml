<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Uygulama kullanım sürelerini okumak için (Ayarlar'dan elle verilir) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"
        xmlns:tools="http://schemas.android.com/tools" />
    <!-- Yüklü uygulamaların listesini görebilmek için -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Cihaz yeniden başladığında takibin devam etmesi için -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Engel ekranını arka plandan açabilmek için -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:label="AppJail"
        android:theme="@style/Theme.AppJail">

        <!-- Limitlerin belirlendiği ana ekran -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Limit dolduğunda engellenen uygulamanın üstüne açılan tam ekran bariyer.
             excludeFromRecents + noHistory: son uygulamalar listesinde iz bırakmaz -->
        <activity
            android:name=".BlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=".blocker"
            android:theme="@style/Theme.AppJail.Block" />

        <!-- Ön plandaki uygulamayı izleyen ve engelleyen erişilebilirlik servisi -->
        <service
            android:name=".BlockerService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Yeniden başlatmada gün kontrolünü tetikleyen alıcı -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
